{
  "name": "dsh-codebuddy",
  "version": "1.0.1",
  "description": "Unofficial third-party DSH plugin: connects Tencent CodeBuddy open platform (copilot.tencent.com) models to DeepSeek Harness. Zero source patches, paste-your-key settings page, automatic model discovery. 非官方插件：把腾讯 CodeBuddy 开放平台的模型接入 DeepSeek Harness。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "test": "node --test test/index.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "codebuddy",
    "llm",
    "adapter",
    "provider"
  ],
  "author": "张托德",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhang-tod/dsh-codebuddy.git"
  },
  "bugs": {
    "url": "https://github.com/zhang-tod/dsh-codebuddy/issues"
  },
  "homepage": "https://github.com/zhang-tod/dsh-codebuddy#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.7-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-credentials": ">=0.1.7-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    }
  }
}
